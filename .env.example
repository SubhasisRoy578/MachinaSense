# --- Backend Configuration ---
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# --- LLM API Keys (Optional - Grounded Fallback used if omitted) ---
