# =========================================================
# MachinaSense — Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# =========================================================

# --- Backend Configuration ---
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# --- Backend-only authentication, database, and provider configuration ---
DATABASE_URL=postgresql+psycopg2://user:password@host:5432/machinasense
CLERK_SECRET_KEY=
CLERK_ISSUER=
CLERK_JWKS_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROK_API_KEY=
GROK_MODEL=grok-3-mini

# --- Frontend Configuration ---
VITE_API_BASE_URL=http://localhost:8000
VITE_CLERK_PUBLISHABLE_KEY=
